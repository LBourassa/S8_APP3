<%- include('partials/header') %>
  <section class="hero">
    <p class="hero__eyebrow">Espace personnel</p>
    <h1>Bonjour <%= user.name %></h1>
    <p class="hero__lead">Bienvenue sur SAQLICPO, votre portail interne de gestion documentaire.</p>
  </section>
  <div class="cards">
    <a class="card card--link" href="/documents">
      <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg></div>
      <h3>Mes documents</h3><p>Consulter les documents déposés.</p>
    </a>
    <a class="card card--link" href="/documents">
      <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V4"/><path d="M7 9l5-5 5 5"/><path d="M5 20h14"/></svg></div>
      <h3>Téléverser une facture</h3><p>Ajouter un nouveau document au format .png.</p>
    </a>
    <div class="card">
      <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></div>
      <h3>Mon compte</h3><p><%= user.name %> · rôle <%= user.role %></p>
    </div>
  </div>
<%- include('partials/footer') %>
