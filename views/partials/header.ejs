<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="stylesheet" href="/style.css">
  <title>SAQLICPO</title>
</head>
<body>
  <header class="topbar">
    <a class="topbar__brand" href="/"><span class="brand"><svg width="28" height="28" viewBox="0 0 28 28"><rect width="28" height="28" rx="8" fill="#f97316"/><g stroke="#2a1206" stroke-width="1.7" fill="none" stroke-linejoin="round"><path d="M10 8.5h5l3 3v8h-8z"/><path d="M15 8.5V11.5h3"/></g></svg><span class="word"><span class="accent">SAQ</span>LICPO</span></span></a>
    <% if (user) { %>
      <nav class="topbar__nav">
        <a href="/">Accueil</a>
        <a href="/documents">Documents</a>
      </nav>
      <div class="topbar__user">
        <span class="chip"><span class="av"><%= (user.name || '?').trim().charAt(0).toUpperCase() %></span> <%= user.name %> · <%= user.role %></span>
        <form method="post" action="/logout"><button class="btn btn--ghost">Déconnexion</button></form>
      </div>
    <% } %>
  </header>
  <main class="page">
