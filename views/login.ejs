<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="stylesheet" href="/style.css">
  <title>Connexion · SAQLICPO</title>
</head>
<body class="auth-body">
  <main class="auth">
    <section class="auth__brand">
      <a class="brand" href="/"><svg width="28" height="28" viewBox="0 0 28 28"><rect width="28" height="28" rx="8" fill="#f97316"/><g stroke="#2a1206" stroke-width="1.7" fill="none" stroke-linejoin="round"><path d="M10 8.5h5l3 3v8h-8z"/><path d="M15 8.5V11.5h3"/></g></svg><span class="word">SAQLICPO</span></a>
      <h1 class="auth__title">Portail interne de gestion documentaire</h1>
      <p class="auth__lead">Déposez, consultez et gérez vos documents administratifs, en un seul endroit.</p>
      <ul class="auth__points">
        <li><span class="tick">✓</span> Dépôt sécurisé des factures et pièces</li>
        <li><span class="tick">✓</span> Accès selon votre rôle</li>
        <li><span class="tick">✓</span> Historique centralisé des documents</li>
      </ul>
    </section>
    <section class="auth__panel">
      <div class="auth__card">
        <h2>Connexion</h2>
        <p class="auth__sub">Accédez à votre espace SAQLICPO.</p>
        <% if (error) { %><p class="alert"><%= error %></p><% } %>
        <form method="post" action="/login">
          <label class="field">Utilisateur<input name="username" autofocus required></label>
          <label class="field">Mot de passe<input type="password" name="password" required></label>
          <button type="submit" class="btn btn--primary btn--block">Se connecter</button>
        </form>
        <p class="auth__foot">© 2026 SAQLICPO · Usage interne</p>
      </div>
    </section>
  </main>
</body>
</html>
